# Copy this file to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=3000

# --- Database (local XAMPP/MySQL defaults) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db
DB_SSL=false
# On cloud platforms you may instead set one connection string:
# DATABASE_URL=mysql://user:pass@host:3306/dbname

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# --- External APIs ---
BASE_CURRENCY=MYR
DEFAULT_COUNTRY=MY
# Telegram Bot API (create a bot with @BotFather). Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
